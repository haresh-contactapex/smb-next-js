DATABASE_URL=postgresql://username:password@127.0.0.1:5433/smb

# Secret used to sign customer and staff session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Shown on login/register/forgot/reset-password pages when Settings ->
# Security's "Enable reCAPTCHA" toggle is on. The values below are Google's
# published reCAPTCHA v2 test keys (always pass verification, no real bot
# protection) — replace with real keys from google.com/recaptcha/admin before
# relying on this for production traffic.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Media uploads are stored on disk in public/uploads/YYYY/MM/ (served by
# src/app/uploads/[...path]), so no storage service or token is needed. The
# folder must be writable by the user running the app.

# Fallback SMTP credentials used to send transactional email (e.g. password
# reset links) until SMTP details are saved in Settings -> Email, which then
# take precedence for the whole system. If neither is set, affected flows
# fall back to logging the content
# server-side instead of sending it, so local dev works without SMTP.
# For Gmail: use smtp.gmail.com, port 587, and a Google Account App
# Password (myaccount.google.com/apppasswords) as SMTP_PASS — a normal
# Gmail password will not work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-your-gmail-address
SMTP_PASS=replace-with-your-app-password
SMTP_FROM="Shop My Band <replace-with-your-gmail-address>"

# --- Real-time admin notifications (optional) ---------------------------------
# Run the WebSocket server with `npm run ws:notifications` (it needs DATABASE_URL
# and JWT_SECRET too). Passenger can't host WebSockets, so run that process separately
# (long-lived). Leave these unset and the bell simply polls every 30s instead.
# Public ws:// or wss:// URL browsers connect to (returned by /api/notifications/ws-token):
NOTIFICATIONS_WS_URL=ws://localhost:3001/ws
# Internal http(s) URL the Next.js app POSTs new notifications to:
NOTIFICATIONS_WS_PUBLISH_URL=http://localhost:3001
# Shared secret protecting POST /publish. Generate with the command shown above for JWT_SECRET.
NOTIFICATIONS_WS_SECRET=replace-with-another-long-random-secret
# Comma-separated browser origins allowed to open a socket (required in production):
NOTIFICATIONS_WS_ALLOWED_ORIGINS=http://localhost:3000
# Port for the WS server (defaults to 3001):
NOTIFICATIONS_WS_PORT=3001

# Number of proxies in front of the app that append to x-forwarded-for (default 1: just the
# server's own proxy). Set 2 when a CDN such as Cloudflare sits in front of it. Used to find the
# visitor's address for rate limits; too low and many visitors share one limit.
# TRUSTED_PROXY_HOPS=1

# Public address of the store, used for links and product photos inside emails.
# Optional: without it the address is read from the request (localhost in development).
# SITE_URL=https://shopmyband.com
